# Required: the SociaBuzz creator that receives the money.
SOCIABUZZ_USERNAME=
# Required: the bot sends this as X-API-Key. Generate: openssl rand -hex 24
API_KEY=

# Optional
# PORT=8000                       # PaaS hosts (Railway, Render) set this themselves
# SESSION_DB_PATH=/data/scbz_sessions.db
# WEBHOOK_ENABLED=false           # the bot polls /api/payment/status itself
# ALLOW_NO_AUTH=true              # local testing only
